<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_devices"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:clickable="true"
    android:focusable="true"

    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@color/cradViewColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Header -->
        <TextView
            android:id="@+id/header_devices"
            android:fontFamily="@font/normal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Device Readings ▼"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center"
            android:paddingBottom="8dp" />

        <!-- Collapsible content -->
        <LinearLayout
            android:id="@+id/content_devices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:gravity="center_horizontal">

            <TextView
                android:fontFamily="@font/normal"
                android:id="@+id/text_washing_machine_reading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Washing Machine: 0 Watts"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:layout_marginTop="8dp"
                android:gravity="center" />

            <TextView
                android:id="@+id/text_fridge_reading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fridge: 0 Watts"
                android:textSize="16sp"
                android:fontFamily="@font/normal"
                android:textColor="@color/black"
                android:layout_marginTop="8dp"
                android:gravity="center" />

            <TextView
                android:id="@+id/text_heating_system_reading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Heating System: 0 Watts"
                android:textSize="16sp"
                android:fontFamily="@font/normal"
                android:textColor="@color/black"
                android:layout_marginTop="8dp"
                android:gravity="center" />

            <TextView
                android:id="@+id/text_last_updated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Last Updated: --"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/normal"
                android:textColor="@color/black"
                android:layout_marginTop="12dp"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
