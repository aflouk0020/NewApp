<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:gravity="start">

        <!-- Dummy Content to Make Scrolling Work -->
        <TextView
            android:id="@+id/user_id_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginTop="10dp"
            android:text="User ID: Loading..."
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:text="Check Rules"
            android:textSize="16sp"
            android:layout_gravity="start"/>

        <!-- Icon Button for Rules -->


        <ImageView
            android:id="@+id/info_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/info_icon"
            android:contentDescription="Rules Icon"
            android:clickable="true"
            android:focusable="true"/>

        <!--        <ImageView-->
<!--            android:id="@+id/info_icon"-->
<!--            android:layout_width="24dp"-->
<!--            android:layout_height="24dp"-->
<!--            android:layout_marginTop="10dp"-->
<!--            android:src="@drawable/info_icon"-->
<!--            android:contentDescription="Rules Icon"-->
<!--            android:clickable="true"-->
<!--            android:focusable="true"-->
<!--            android:onClick="showRulesDialog" />-->


        <TextView
            android:id="@+id/family_size_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Family Size: Loading..."
            android:textSize="18sp" />

        <TextView
            android:id="@+id/room_number_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Number of Rooms: Loading..."
            android:textSize="18sp" />

    </LinearLayout>
</ScrollView>
