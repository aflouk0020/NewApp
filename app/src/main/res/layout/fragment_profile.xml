<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Profile Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center_horizontal">

                <!-- User ID -->
                <TextView
                    android:id="@+id/user_id_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User ID: Loading..."
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:layout_marginBottom="8dp"/>

                <!-- Check Rules -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Check Rules"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_marginEnd="8dp"/>

                    <!-- Info Icon -->
                    <ImageView
                        android:id="@+id/info_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/info_icon"
                        android:contentDescription="Rules Icon"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Household Info Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Family Size -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Family Size"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/family_size_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Loading..."
                    android:enabled="false"
                    android:textSize="16sp"
                    android:background="@drawable/edit_text_bg"
                    android:padding="8dp"/>

                <!-- Room Number -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Number of Rooms"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/room_number_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Loading..."
                    android:enabled="false"
                    android:textSize="16sp"
                    android:background="@drawable/edit_text_bg"
                    android:padding="8dp"/>

                <!-- Energy Usage -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Energy Usage"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/energy_usage_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Calculating..."
                    android:enabled="false"
                    android:textSize="16sp"
                    android:background="@drawable/edit_text_bg"
                    android:padding="8dp"/>

                <!-- Monthly kWh -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estimated Monthly kWh"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/kwh_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Loading..."
                    android:enabled="false"
                    android:textSize="16sp"
                    android:background="@drawable/edit_text_bg"
                    android:padding="8dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Edit Button -->
        <Button
            android:id="@+id/edit_household_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edit Household Info"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/customGrayGreen"
            android:padding="12dp"
            android:layout_marginTop="16dp"/>
    </LinearLayout>
</ScrollView>
