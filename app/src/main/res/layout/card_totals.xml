<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_totals"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@color/cradViewColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"

        android:gravity="center_horizontal">

        <!-- Header -->
        <TextView
            android:id="@+id/header_totals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Totals ▼"
            android:textSize="18sp"
            android:fontFamily="@font/normal"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center"
            android:paddingBottom="8dp" />

        <!-- Collapsible Content -->
        <LinearLayout
            android:id="@+id/content_totals"
            android:fontFamily="@font/normal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/text_total_washing_machine"
                android:layout_width="match_parent"
                android:fontFamily="@font/normal"
                android:layout_height="wrap_content"
                android:text="Total Washing Machine: 0 Watts"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:layout_marginTop="8dp"
                android:gravity="center" />

            <TextView
                android:id="@+id/text_total_fridge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total Fridge: 0 Watts"
                android:textSize="16sp"
                android:fontFamily="@font/normal"
                android:textColor="@color/black"
                android:layout_marginTop="8dp"
                android:gravity="center" />

            <TextView
                android:id="@+id/text_total_heating_system"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total Heating System: 0 Watts"
                android:textSize="16sp"
                android:fontFamily="@font/normal"
                android:textColor="@color/black"
                android:layout_marginTop="8dp"
                android:gravity="center" />

            <TextView
                android:id="@+id/text_total_usage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total Usage: 0.00 Watts"
                android:textSize="16sp"
                android:fontFamily="@font/normal"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginTop="12dp"
                android:gravity="center" />

            <TextView
                android:id="@+id/text_totals_timestamp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Last Updated: --"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/normal"
                android:textColor="@color/black"
                android:layout_marginTop="12dp"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
