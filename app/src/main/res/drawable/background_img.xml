<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="1080dp"
    android:height="1920dp"
    android:viewportWidth="1080"
    android:viewportHeight="1920">

  <!-- 🎨 Background Gradient (Energetic & Motivational) -->
  <path
      android:pathData="M0,0h1080v1920h-1080z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:startX="0"
          android:startY="0"
          android:endX="1080"
          android:endY="1920"
          android:type="linear">
        <item android:offset="0" android:color="#ced4f2" />
        <item android:offset="0.3" android:color="#a8acbf" />
        <item android:offset="0.7" android:color="#6a78a6" />
        <item android:offset="1" android:color="#4e5b88" />
      </gradient>
    </aapt:attr>
  </path>

  <!-- 🔵 Central Milestone Circle (Progress Indicator) -->
  <path
      android:pathData="M540,960m-300,0a300,300 0,1 1,600 0a300,300 0,1 1,-600 0"
      android:fillColor="#FFFFFF"
      android:fillAlpha="0.15"/>

  <!-- ⚡ Energy Wave (Dynamic Flow) -->
  <path
      android:pathData="M100,1400c250,-200 600,100 800,-150s250,300 0,450s-500,-50 -800,-150"
      android:fillColor="#ffffff"
      android:fillAlpha="0.10"/>

  <!-- 🏆 Achievement Badges (Top-Right) -->
  <path
      android:pathData="M900,300m-80,0a80,80 0,1 1,160 0a80,80 0,1 1,-160 0"
      android:fillColor="#ffd700"
      android:fillAlpha="0.8"/>

  <path
      android:pathData="M750,800m-90,0a90,90 0,1 1,180 0a90,90 0,1 1,-180 0"
      android:fillColor="#ff5733"
      android:fillAlpha="0.7"/>

  <!-- ⚙ Task Progress Indicators (Bottom-Left) -->
  <path
      android:pathData="M200,1600m-100,0a100,100 0,1 1,200 0a100,100 0,1 1,-200 0"
      android:fillColor="#32a852"
      android:fillAlpha="0.6"/>

  <path
      android:pathData="M500,1800m-70,0a70,70 0,1 1,140 0a70,70 0,1 1,-140 0"
      android:fillColor="#0073e6"
      android:fillAlpha="0.6"/>

  <!-- 🔥 Challenge Circles (Encouraging User Participation) -->
  <path
      android:pathData="M350,1200m-130,0a130,130 0,1 1,260 0a130,130 0,1 1,-260 0"
      android:fillColor="#ff9900"
      android:fillAlpha="0.5"/>

  <path
